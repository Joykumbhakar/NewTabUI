{
  "manifest_version": 3,
  "name": "Liquid Glass New Tab",
  "version": "1.0.0",
  "description": "A beautiful Brave-style new tab page with liquid glass UI, animated wallpaper slideshow, and live widgets.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "geolocation"
  ],
  "host_permissions": [
    "https://ipapi.co/*",
    "https://api.open-meteo.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}